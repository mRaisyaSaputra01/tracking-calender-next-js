generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model users {
  id                      Int         @id @default(autoincrement())
  email                   String      @unique
  tracking_started_at     DateTime    @default(now()) @db.DateTime(0)

  tasks                   tasks[]
  daily_results           daily_results[]
}

model tasks {
  id          Int         @id @default(autoincrement())
  user_id     Int
  tasks       String
  date        DateTime    @db.Date
  completed   Boolean
  locked      Boolean

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([user_id, date])
}

model daily_results {
  id          Int         @id @default(autoincrement())
  user_id     Int         
  date        DateTime    @db.Date
  status      Boolean

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@unique([user_id, date])
}

